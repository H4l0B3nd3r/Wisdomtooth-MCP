// Docker variants for kilo.jsonc.
// Docker implies the API backend: the subscription path needs the `claude`
// CLI plus your host OAuth login state, neither of which lives in the image.
// Set ADVISOR_BACKEND=api explicitly so it fails loudly rather than
// silently, if the key is ever missing.
{
  "mcp": {
    // Option A: Kilo launches a throwaway container per session (stdio)
    "wisdomtooth": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "ANTHROPIC_API_KEY", "wisdomtooth-mcp"],
      "environment": { "ADVISOR_BACKEND": "api", "ANTHROPIC_API_KEY": "sk-ant-your-key-here" },
      "enabled": true,
      "timeout": 300000
    }
    // Option B: persistent container, remote transport. First run:
    //   docker run -d --name wisdomtooth -p 8484:8484 \
    //     -e ADVISOR_BACKEND=api -e ANTHROPIC_API_KEY=sk-ant-... -e ADVISOR_TRANSPORT=http \
    //     -e ADVISOR_HOST=0.0.0.0 wisdomtooth-mcp
    // then use:
    // "wisdomtooth": { "type": "remote", "url": "http://localhost:8484/mcp", "enabled": true }
  }
}
