// Merge into kilo.jsonc (project root) or your global kilo.json.
// DEFAULT SETUP — subscription first, API credits only as a fallback.
// Requires Claude Code installed and logged in: run `claude`, then /login with
// your claude.ai (Pro/Max) account, and check `claude auth status`.
// ANTHROPIC_API_KEY is optional: include it ONLY if you want consults to keep
// working (on paid credits) after the plan's headless quota is exhausted.
{
  "mcp": {
    "wisdomtooth": {
      "type": "local",
      "command": ["wisdomtooth-mcp"],
      "environment": {
        // "auto" is the default; stated here so the billing choice is visible.
        "ADVISOR_BACKEND": "auto",
        "ADVISOR_MODEL": "balanced",
        // Driving this from a LOCAL model? See kilo.local-models.jsonc
        // and set these two -- they matter more than anything else here.
        // "ADVISOR_MINIMAL_TOOLS": "1",
        // "ADVISOR_ANSWER_BUDGET": "500",
        "ADVISOR_EFFORT": "high"
        // "ANTHROPIC_API_KEY": "sk-ant-..."   // optional fallback only
      },
      "enabled": true,
      // Kilo's per-request timeout, restarted by every progress notification.
      // The server sends one every ADVISOR_PROGRESS_INTERVAL (15s) during a
      // consult, so consults may run past this; it only has to exceed 15s.
      "timeout": 300000
    }
  }
}
