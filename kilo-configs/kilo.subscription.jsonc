// SUBSCRIPTION ONLY (Pro/Max) — never spends API credits, even if the plan's
// headless quota runs out. Requires Claude Code installed and logged in via
// `claude` -> /login with your claude.ai account (`claude auth status` confirms).
// No ANTHROPIC_API_KEY needed or wanted here.
{
  "mcp": {
    "wisdomtooth": {
      "type": "local",
      "command": ["wisdomtooth-mcp"],
      "environment": {
        "ADVISOR_BACKEND": "claude-code",
        "ADVISOR_MODEL": "balanced",
        // Driving this from a LOCAL model? See kilo.local-models.jsonc
        // and set these two -- they matter more than anything else here.
        // "ADVISOR_MINIMAL_TOOLS": "1",
        // "ADVISOR_ANSWER_BUDGET": "500",
        // Optional: durable headless auth for GUI-launched editors.
        // Create with `claude setup-token`.
        // "CLAUDE_CODE_OAUTH_TOKEN": "...",
        // Optional: absolute path if the GUI process has a reduced PATH.
        "ADVISOR_CLAUDE_BIN": ""
      },
      "enabled": true,
      "timeout": 300000
    }
  }
}
